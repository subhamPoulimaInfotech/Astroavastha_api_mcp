{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "*": ["./node_modules/*", "../Astroavastha_api_backend/node_modules/*"]
    },
    "outDir": "./build",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "typeRoots": ["../Astroavastha_api_backend/node_modules/@types"],
    "types": ["node"]
  },
  "include": ["src/**/*"]
}
